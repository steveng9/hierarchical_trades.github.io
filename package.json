{
  "name": "hierarchical-trades",
  "version": "1.0.0",
  "description": "Agent-based simulation of emergent institutional hierarchy in trade networks",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "test:golden": "node --test test/golden.test.js",
